<resources>
    <!--
      API 19 baseline. Theme.Material.* and android:colorAccent do not exist on
      Android 4.4; referencing them here would fail style resolution at runtime.
      values-v21/styles.xml restores the Material parents and the accent colour.
    -->
    <style name="AppThemeCore" parent="android:style/Theme.Holo.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#070A0F</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/TvDialogTheme</item>
    </style>
    <style name="AppTheme" parent="AppThemeCore" />

    <style name="TvDialogThemeCore" parent="android:style/Theme.Holo.Dialog">
        <item name="android:windowBackground">@drawable/tv_dialog_surface</item>
        <item name="android:textColorPrimary">#F2F4F8</item>
        <item name="android:textColorSecondary">#A8B2C4</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
    <style name="TvDialogTheme" parent="TvDialogThemeCore" />
</resources>
